# docker compose reads this file after it is copied to .env.
# Record and freeze the resolved image digest before measured runs.
QDRANT_IMAGE=qdrant/qdrant:v1.19.2
QDRANT_MEMORY_LIMIT=28g
QDRANT_CPUS=8

# Export client variables in your shell; the CLI does not need a server API key
# when using the loopback-only Compose service or an SSH-forwarded connection.
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=

# Optional VM-side telemetry; export in the benchmark client's environment.
# QDRANT_PID=
# QDRANT_CGROUP_PATH=
# QDRANT_STORAGE_PATH=

# The checked-in .env.example must never contain live credentials.

