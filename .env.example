# docker compose reads this file after it is copied to .env.
# Record and freeze the resolved image digest before measured runs:
#   QDRANT_IMAGE=qdrant/qdrant@sha256:...
QDRANT_IMAGE=qdrant/qdrant:v1.19.2
QDRANT_MEMORY_LIMIT=28g

# Client variables are exported in your shell, not read from this file.
# The loopback Compose service needs no API key.
#   QDRANT_URL=http://127.0.0.1:6333
#   QDRANT_API_KEY=

# VM telemetry targets are exported by `source scripts/vm-env.sh`:
#   QDRANT_CONTAINER_ID, QDRANT_PID, QDRANT_CGROUP_PATH, QDRANT_STORAGE_PATH

# The checked-in .env.example must never contain live credentials.
